{
  "name": "kt-shop",
  "version": "0.1.0",
  "private": true,
  "description": "KT-SHOP - Dự án thực hành thương mại điện tử full-stack",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "check:structure": "node scripts/check-structure.mjs",
    "setup": "node scripts/setup-env.mjs",
    "db:setup": "npm run db:generate --workspace backend && npm run db:migrate --workspace backend && npm run db:seed --workspace backend",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "test:smoke": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser-premium.mjs",
    "test:address:browser": "node scripts/browser-address.mjs",
    "test:audit": "node scripts/audit-premium.mjs"
  }
}