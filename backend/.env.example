NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=file:./prisma/dev.db
# setup sinh secret ngau nhien vao .env, khong commit secret
JWT_SECRET=
# Google Gemini AI Chatbot
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
# Optional demo display only. Never configure a real receiving account for this exercise.
DEMO_BANK_NAME=
DEMO_BANK_ACCOUNT=
DEMO_BANK_HOLDER=
